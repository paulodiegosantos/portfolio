---
import { Github, Linkedin, Mail } from "lucide-astro";
import Image from "astro/components/Image.astro";
import logo from "../assets/logo.png";
---

<footer class="mt-24 border-t border-white/10 bg-[#2C2C2C]">

	<div class="mx-auto max-w-7xl px-6 pt-6 pb-4">

		<!-- Conteúdo principal -->
		<div class="flex flex-col items-center text-center">

			<!-- Logo -->
			<a
				href="#"
				class="text-3xl font-bold tracking-tight"
			>
				<Image
					src={logo}
					alt="Logo PDS"
					height={32}
				/>
			</a>

			<p class="mt-4 text-lg font-medium text-white">
				Paulo Diego Dos Santos
			</p>

			<p class="mt-2 text-white/60">
				Desenvolvedor de Software
			</p>
		</div>

		<!-- Linha divisória -->
		<div class="my-4 border-t border-white/10"></div>

		<!-- Rodapé inferior -->
		<div
			class="flex flex-col items-center justify-center text-sm text-white/50 md:flex-row"
		>

			<p>
				© 2026. Todos os direitos reservados.
			</p>

		</div>

	</div>

</footer>